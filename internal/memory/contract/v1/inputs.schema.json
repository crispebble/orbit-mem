{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onidot.dev/schemas/orbit.memory/1/inputs.schema.json",
  "title": "orbit.memory 1.1 도구 입력",
  "description": "모든 칸은 선택이다. 모르는 칸은 받아들이고 응답 ignoredArgs에 이름이 나온다. 형이 틀린 칸은 INVALID_ARGUMENT다.",
  "$defs": {
    "major": {"type": "integer", "minimum": 1, "description": "읽는 쪽이 읽을 수 있는 주판. 기본 1"},
    "memoryKind": {"enum": ["rule", "fact", "decision", "lesson", "journal"]},
    "memoryState": {"enum": ["candidate", "confirmed", "stale", "hidden"]},
    "relation": {"enum": ["link", "supersede", "session", "file", "tag"]},
    "time": {"type": "string", "description": "RFC 3339 시각"},
    "memory_graph": {
      "type": "object",
      "properties": {
        "major": {"$ref": "#/$defs/major"},
        "focus": {"type": "string", "description": "주면 이 기억에서 depth 단계 안의 기억만 준다. 이 기억은 거르기와 상관없이 늘 들어간다"},
        "depth": {"type": "integer", "minimum": 1, "description": "focus에서 따라갈 단계 수. 기본 1, depthMax보다 크면 depthMax"},
        "via": {"type": "array", "items": {"$ref": "#/$defs/relation"}, "description": "주변을 따라갈 때 건너는 관계. 기본 link·supersede·session·file(tag는 빼 둔다)"},
        "kinds": {"type": "array", "items": {"$ref": "#/$defs/memoryKind"}, "description": "기억 종류로 거른다. 기본 모두"},
        "states": {"type": "array", "items": {"$ref": "#/$defs/memoryState"}, "description": "기억 상태로 거른다. 기본 candidate·confirmed·stale"},
        "scopes": {"type": "array", "items": {"type": "string", "pattern": "^(global|project:.+)$"}, "description": "범위로 거른다(global·project:<키>). 기본 모두"},
        "tags": {"type": "array", "items": {"type": "string"}, "description": "이 태그 중 하나라도 가진 기억만"},
        "updatedFrom": {"$ref": "#/$defs/time", "description": "이 시각 이후에 고친 기억만"},
        "updatedTo": {"$ref": "#/$defs/time", "description": "이 시각까지 고친 기억만"},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}, "description": "응답에 담을 선·묶음 종류. 기본 모두"},
        "limit": {"type": "integer", "minimum": 1, "description": "줄 기억 수 상한. 기본·최대 limitMax. 넘으면 최근에 고친 것부터 남기고 truncated"}
      }
    }
  }
}
