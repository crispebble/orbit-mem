{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onidot.dev/schemas/orbit.decision/1/inputs.schema.json",
  "title": "orbit.decision 1.0 도구 입력",
  "description": "표시한 필수 칸 말고는 선택이다. 모르는 칸은 받아들이고 응답 ignoredArgs에 이름이 나온다. 형이 틀린 칸은 INVALID_ARGUMENT다.",
  "$defs": {
    "major": {
      "type": "integer",
      "minimum": 1,
      "description": "읽는 쪽이 읽을 수 있는 주판. 기본 1"
    },
    "id": {
      "type": "string",
      "description": "카드 id"
    },
    "option": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "선택지 id. 비우면 1부터 센 위치"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "text",
        "options"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "multiSelect": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "recommended": {
          "type": "string",
          "description": "추천 선택지 id"
        },
        "reason": {
          "type": "string",
          "description": "추천 이유"
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "work",
            "session",
            "step",
            "atlas",
            "pr",
            "memory",
            "url"
          ]
        },
        "ref": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "decision_list": {
      "type": "object",
      "properties": {
        "major": {
          "$ref": "#/$defs/major"
        },
        "state": {
          "type": "array",
          "items": {
            "enum": [
              "open",
              "answered",
              "withdrawn",
              "expired"
            ]
          },
          "description": "카드 상태. 기본 open"
        },
        "source": {
          "type": "array",
          "items": {
            "enum": [
              "question",
              "permission",
              "ops",
              "plugin",
              "assumption"
            ]
          },
          "description": "카드 출처. 기본 모두"
        },
        "sessionId": {
          "type": "string",
          "description": "이 세션의 카드만"
        },
        "workId": {
          "type": "string",
          "description": "이 작업의 카드만"
        },
        "updatedSince": {
          "type": "string",
          "description": "RFC 3339 시각. 이 뒤에 바뀐 카드만(오늘 내린 결정)"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "최대 개수. limitMax보다 크면 limitMax"
        }
      }
    },
    "decision_get": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "major": {
          "$ref": "#/$defs/major"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "decision_changes": {
      "type": "object",
      "properties": {
        "major": {
          "$ref": "#/$defs/major"
        },
        "after": {
          "type": "string",
          "description": "앞 응답의 seq. work_changes의 seq와 같은 커서다. 없으면 reset"
        },
        "wait": {
          "type": "integer",
          "minimum": 0,
          "description": "바뀐 것이 없을 때 기다릴 밀리초. waitMax보다 크면 waitMax"
        }
      }
    },
    "decision_open": {
      "type": "object",
      "required": [
        "source",
        "owner",
        "questions"
      ],
      "properties": {
        "major": {
          "$ref": "#/$defs/major"
        },
        "id": {
          "type": "string",
          "description": "카드 id. 비우면 새로 붙인다. 이미 있는 id면 CONFLICT"
        },
        "source": {
          "enum": [
            "question",
            "permission",
            "ops",
            "plugin",
            "assumption"
          ]
        },
        "owner": {
          "enum": [
            "orbit-pi",
            "human",
            "studio"
          ],
          "description": "답을 세션에 넘길 책임자"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          },
          "description": "질문 1~10개, 질문마다 선택지 0~20개"
        },
        "context": {
          "type": "string",
          "description": "근거·배경"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "work": {
          "type": "object",
          "properties": {
            "host": {
              "enum": [
                "claude",
                "codex",
                "orbit-pi"
              ]
            },
            "sessionId": {
              "type": "string"
            },
            "workId": {
              "type": "string"
            },
            "stepId": {
              "type": "string"
            },
            "waitKey": {
              "type": "string"
            }
          },
          "description": "묶을 세션·작업·단계. host·sessionId만 주면 그때 진행 중인 단계에 묶는다"
        },
        "binding": {
          "type": "object",
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            }
          },
          "description": "카드가 묶인 대상(예: PR 머리 커밋)"
        },
        "expiresAt": {
          "type": "string",
          "description": "RFC 3339 시각. 지나면 expired"
        }
      }
    },
    "decision_answer": {
      "type": "object",
      "required": [
        "id",
        "answers",
        "by"
      ],
      "properties": {
        "major": {
          "$ref": "#/$defs/major"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "optionIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "text": {
                "type": "string"
              }
            }
          },
          "description": "질문마다 하나, 같은 순서"
        },
        "by": {
          "enum": [
            "studio",
            "telegram",
            "terminal",
            "host",
            "orbit-pi"
          ],
          "description": "답한 곳"
        }
      }
    },
    "decision_withdraw": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "major": {
          "$ref": "#/$defs/major"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "type": "string",
          "description": "거둔 이유(예: binding_changed, runtime_stopped)"
        }
      }
    }
  }
}