{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onidot.dev/schemas/orbit.work/1/response.schema.json",
  "title": "orbit.work 1.0 응답",
  "description": "orb가 내는 1.0 응답을 엄격하게 검사한다. 읽는 쪽은 이 Schema로 응답을 거르지 않고 판 규칙대로 모르는 칸·값을 견딘다.",
  "oneOf": [
    {"$ref": "#/$defs/work_list"},
    {"$ref": "#/$defs/work_get"},
    {"$ref": "#/$defs/work_title"},
    {"$ref": "#/$defs/work_sessions"},
    {"$ref": "#/$defs/work_changes"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "id": {"type": "string", "minLength": 1},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "text": {"type": "string"},
    "absPath": {"type": "string", "pattern": "^/"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "major", "minor", "supportedMajors"],
      "properties": {
        "name": {"const": "orbit.work"},
        "major": {"const": 1},
        "minor": {"type": "integer", "minimum": 0},
        "supportedMajors": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1, "contains": {"const": 1}}
      }
    },
    "ignoredArgs": {"type": "array", "items": {"type": "string"}},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "label"],
      "properties": {
        "scope": {"type": "string", "pattern": "^project:.+"},
        "label": {"type": "string"}
      }
    },
    "host": {"enum": ["claude", "codex"]},
    "surface": {"enum": ["cli", "desktop", "headless", "unknown"]},
    "listKind": {"enum": ["claude-task", "claude-todo", "claude-app-plan", "codex-plan"]},
    "stepStatus": {"enum": ["pending", "ready", "in_progress", "blocked", "done", "cancelled"]},
    "blockReason": {"enum": ["waiting_user", "run_failed", "run_lost", "interrupted", "stale", "declared"]},
    "verificationState": {"enum": ["none", "pass", "fail", "needs_user"]},
    "sessionState": {"enum": ["running", "waiting_user", "idle", "stale", "ended"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "ready", "in_progress", "blocked", "done", "cancelled"],
      "properties": {
        "pending": {"type": "integer", "minimum": 0},
        "ready": {"type": "integer", "minimum": 0},
        "in_progress": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "done": {"type": "integer", "minimum": 0},
        "cancelled": {"type": "integer", "minimum": 0}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "surface", "sessionId", "list"],
      "properties": {
        "host": {"$ref": "#/$defs/host"},
        "surface": {"$ref": "#/$defs/surface"},
        "sessionId": {"$ref": "#/$defs/id"},
        "list": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"$ref": "#/$defs/listKind"},
            "id": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workId"],
      "properties": {
        "workId": {"$ref": "#/$defs/id"},
        "stepId": {"$ref": "#/$defs/id"}
      }
    },
    "workHead": {
      "description": "작업 요약과 전체 그래프가 함께 쓰는 칸",
      "type": "object",
      "required": ["id", "title", "titleSource", "state", "origin", "openedAt", "updatedAt", "counts"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/text"},
        "titleSource": {"enum": ["ai", "step"]},
        "titleUpdatedAt": {"$ref": "#/$defs/time"},
        "state": {"enum": ["open", "done"]},
        "cwd": {"$ref": "#/$defs/absPath"},
        "project": {"$ref": "#/$defs/project"},
        "origin": {"$ref": "#/$defs/origin"},
        "parent": {"$ref": "#/$defs/parent"},
        "openedAt": {"$ref": "#/$defs/time"},
        "updatedAt": {"$ref": "#/$defs/time"},
        "closedAt": {"$ref": "#/$defs/time"},
        "counts": {"$ref": "#/$defs/counts"}
      }
    },
    "workSummary": {
      "allOf": [{"$ref": "#/$defs/workHead"}],
      "required": ["stepCount", "verification"],
      "properties": {
        "id": true, "title": true, "titleSource": true, "titleUpdatedAt": true, "state": true, "cwd": true,
        "project": true, "origin": true, "parent": true, "openedAt": true, "updatedAt": true, "closedAt": true, "counts": true,
        "stepCount": {"type": "integer", "minimum": 0},
        "verification": {
          "description": "단계 검증 결과별 수. outdated는 지난 검증이 붙은 단계 수(제안)",
          "type": "object",
          "additionalProperties": false,
          "required": ["none", "pass", "fail", "needs_user", "outdated"],
          "properties": {
            "none": {"type": "integer", "minimum": 0},
            "pass": {"type": "integer", "minimum": 0},
            "fail": {"type": "integer", "minimum": 0},
            "needs_user": {"type": "integer", "minimum": 0},
            "outdated": {"type": "integer", "minimum": 0}
          }
        }
      },
      "unevaluatedProperties": false
    },
    "work": {
      "allOf": [{"$ref": "#/$defs/workHead"}],
      "required": ["steps", "runs", "evidence"],
      "properties": {
        "id": true, "title": true, "titleSource": true, "titleUpdatedAt": true, "state": true, "cwd": true,
        "project": true, "origin": true, "parent": true, "openedAt": true, "updatedAt": true, "closedAt": true, "counts": true,
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "children": {"description": "includeChildren일 때만(제안)", "type": "array", "items": {"$ref": "#/$defs/work"}}
      },
      "unevaluatedProperties": false
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order", "wave", "after", "status", "verification", "evidenceIds", "childWorkIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {"kind": {"$ref": "#/$defs/listKind"}, "id": {"$ref": "#/$defs/id"}}
        },
        "title": {"$ref": "#/$defs/text"},
        "activeTitle": {"$ref": "#/$defs/text"},
        "order": {"type": "integer", "minimum": 0},
        "wave": {"type": "integer", "minimum": 0},
        "after": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stepId", "source"],
            "properties": {"stepId": {"$ref": "#/$defs/id"}, "source": {"enum": ["native", "order"]}}
          }
        },
        "status": {"$ref": "#/$defs/stepStatus"},
        "block": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "since"],
          "properties": {
            "reason": {"$ref": "#/$defs/blockReason"},
            "detail": {"$ref": "#/$defs/text"},
            "since": {"$ref": "#/$defs/time"}
          }
        },
        "assignee": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["main", "subagent", "session"]},
            "role": {"$ref": "#/$defs/text"},
            "host": {"$ref": "#/$defs/host"},
            "model": {"$ref": "#/$defs/text"}
          }
        },
        "startedAt": {"$ref": "#/$defs/time"},
        "finishedAt": {"$ref": "#/$defs/time"},
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "outdated"],
          "properties": {
            "state": {"$ref": "#/$defs/verificationState"},
            "outdated": {"type": "boolean"},
            "evidenceId": {"$ref": "#/$defs/id"}
          }
        },
        "evidenceIds": {"$ref": "#/$defs/ids"},
        "childWorkIds": {"$ref": "#/$defs/ids"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]}, "then": {"required": ["block"]}, "else": {"not": {"required": ["block"]}}}
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "host", "link", "state", "startedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["subagent", "session"]},
        "host": {"$ref": "#/$defs/host"},
        "role": {"$ref": "#/$defs/text"},
        "agentId": {"$ref": "#/$defs/id"},
        "sessionId": {"$ref": "#/$defs/id"},
        "parentSessionId": {"$ref": "#/$defs/id"},
        "stepId": {"$ref": "#/$defs/id"},
        "link": {"enum": ["owner", "single_active", "parent_env", "none"]},
        "background": {"type": "boolean"},
        "cwd": {"$ref": "#/$defs/absPath"},
        "repo": {"$ref": "#/$defs/absPath"},
        "branch": {"$ref": "#/$defs/text"},
        "state": {"enum": ["running", "finished", "failed", "lost"]},
        "endReason": {"enum": ["completed", "failed", "session_ended", "unknown"]},
        "startedAt": {"$ref": "#/$defs/time"},
        "lastSeenAt": {"$ref": "#/$defs/time"},
        "finishedAt": {"$ref": "#/$defs/time"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "at", "result"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["command", "commit", "verdict"]},
        "stepId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "at": {"$ref": "#/$defs/time"},
        "result": {"enum": ["ok", "fail", "pass", "needs_fix", "needs_user"]},
        "summary": {"$ref": "#/$defs/text"},
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": {"$ref": "#/$defs/absPath"},
            "sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
            "transcript": {"$ref": "#/$defs/absPath"}
          }
        },
        "files": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "command"}}}, "then": {"properties": {"result": {"enum": ["ok", "fail"]}}}},
        {"if": {"properties": {"kind": {"const": "commit"}}}, "then": {"properties": {"result": {"const": "ok"}}, "required": ["ref"]}},
        {"if": {"properties": {"kind": {"const": "verdict"}}}, "then": {"properties": {"result": {"enum": ["pass", "needs_fix", "needs_user"]}}}}
      ]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "host", "surface", "state", "startedAt", "lastSeenAt", "openWorkIds", "activeStepIds"],
      "properties": {
        "sessionId": {"$ref": "#/$defs/id"},
        "host": {"$ref": "#/$defs/host"},
        "surface": {"$ref": "#/$defs/surface"},
        "cwd": {"$ref": "#/$defs/absPath"},
        "repo": {"$ref": "#/$defs/absPath"},
        "branch": {"$ref": "#/$defs/text"},
        "project": {"$ref": "#/$defs/project"},
        "parentSessionId": {"$ref": "#/$defs/id"},
        "model": {"$ref": "#/$defs/text"},
        "state": {"$ref": "#/$defs/sessionState"},
        "endReason": {"enum": ["session_end", "unknown"]},
        "endDetail": {"description": "호스트가 세션 끝에 준 이유(제안)", "$ref": "#/$defs/text"},
        "startedAt": {"$ref": "#/$defs/time"},
        "lastSeenAt": {"$ref": "#/$defs/time"},
        "endedAt": {"$ref": "#/$defs/time"},
        "openWorkIds": {"$ref": "#/$defs/ids"},
        "activeStepIds": {"$ref": "#/$defs/ids"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "ended"}}, "required": ["state"]}, "then": {"required": ["endReason", "endedAt"]}, "else": {"not": {"anyOf": [{"required": ["endReason"]}, {"required": ["endedAt"]}]}}}
      ]
    },
    "sessionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "at", "kind"],
      "properties": {
        "seq": {"$ref": "#/$defs/id"},
        "at": {"$ref": "#/$defs/time"},
        "kind": {"enum": ["session.started", "turn.started", "turn.ended", "step.changed", "run.started", "run.ended", "evidence.added", "block.opened", "block.cleared", "session.ended"]},
        "workId": {"$ref": "#/$defs/id"},
        "stepId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "summary": {"$ref": "#/$defs/text"},
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transcript": {"$ref": "#/$defs/absPath"},
            "agentTranscript": {"$ref": "#/$defs/absPath"}
          }
        }
      }
    },
    "work_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "seq", "items", "limitMax"],
      "properties": {
        "contract": {"$ref": "#/$defs/contract"},
        "seq": {"$ref": "#/$defs/id"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/workSummary"}},
        "nextCursor": {"$ref": "#/$defs/id"},
        "limitMax": {"type": "integer", "minimum": 1},
        "ignoredArgs": {"$ref": "#/$defs/ignoredArgs"}
      }
    },
    "work_get": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "seq", "work"],
      "properties": {
        "contract": {"$ref": "#/$defs/contract"},
        "seq": {"$ref": "#/$defs/id"},
        "work": {"$ref": "#/$defs/work"},
        "ignoredArgs": {"$ref": "#/$defs/ignoredArgs"}
      }
    },
    "work_title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "seq", "work", "titleMax"],
      "properties": {
        "contract": {"$ref": "#/$defs/contract"},
        "seq": {"$ref": "#/$defs/id"},
        "work": {"$ref": "#/$defs/workSummary"},
        "titleMax": {"type": "integer", "minimum": 1},
        "ignoredArgs": {"$ref": "#/$defs/ignoredArgs"}
      }
    },
    "work_sessions": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "seq", "sessions", "limitMax"],
          "properties": {
            "contract": {"$ref": "#/$defs/contract"},
            "seq": {"$ref": "#/$defs/id"},
            "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}},
            "nextCursor": {"$ref": "#/$defs/id"},
            "limitMax": {"type": "integer", "minimum": 1},
            "ignoredArgs": {"$ref": "#/$defs/ignoredArgs"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "seq", "session", "events", "limitMax"],
          "properties": {
            "contract": {"$ref": "#/$defs/contract"},
            "seq": {"$ref": "#/$defs/id"},
            "session": {"$ref": "#/$defs/session"},
            "events": {"type": "array", "items": {"$ref": "#/$defs/sessionEvent"}},
            "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
            "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
            "nextCursor": {"$ref": "#/$defs/id"},
            "limitMax": {"type": "integer", "minimum": 1},
            "ignoredArgs": {"$ref": "#/$defs/ignoredArgs"}
          }
        }
      ]
    },
    "work_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "seq", "reset", "more", "waitMax"],
      "properties": {
        "contract": {"$ref": "#/$defs/contract"},
        "seq": {"$ref": "#/$defs/id"},
        "reset": {"type": "boolean"},
        "more": {"type": "boolean"},
        "waitMax": {"type": "integer", "minimum": 0},
        "workIds": {"$ref": "#/$defs/ids"},
        "sessionIds": {"$ref": "#/$defs/ids"},
        "ignoredArgs": {"$ref": "#/$defs/ignoredArgs"}
      },
      "if": {"properties": {"reset": {"const": true}}},
      "then": {"properties": {"more": {"const": false}}, "not": {"anyOf": [{"required": ["workIds"]}, {"required": ["sessionIds"]}]}},
      "else": {"required": ["workIds", "sessionIds"]}
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "error"],
      "properties": {
        "contract": {"$ref": "#/$defs/contract"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"enum": ["UNSUPPORTED_MAJOR", "INVALID_ARGUMENT", "AMBIGUOUS_WORK", "NOT_FOUND"]},
            "message": {"type": "string"},
            "field": {"type": "string"},
            "supportedMajors": {"type": "array", "items": {"type": "integer", "minimum": 1}},
            "candidates": {"$ref": "#/$defs/ids"}
          },
          "allOf": [
            {"if": {"properties": {"code": {"const": "UNSUPPORTED_MAJOR"}}}, "then": {"required": ["supportedMajors"]}},
            {"if": {"properties": {"code": {"const": "AMBIGUOUS_WORK"}}}, "then": {"required": ["candidates"]}}
          ]
        }
      }
    }
  }
}
