{
  "mcpServers": {
    "orbit": {
      "command": "{{orb}}",
      "args": [
        "mcp"
      ],
      "envVars": [
        "ORBIT_HOME"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "command": "{{orbcmd}} hook session-start --host {{host}}",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "command": "{{orbcmd}} hook prompt --host {{host}}",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "hosts": [
          "claude"
        ],
        "matcher": "TaskCreate|TaskUpdate|TaskGet|TaskList|TodoWrite|mcp__ccd_turn__update_plan|mcp__ccd_turn__wrap_up",
        "command": "{{orbcmd}} hook work --host {{host}}",
        "timeout": 10
      },
      {
        "hosts": [
          "codex"
        ],
        "matcher": "update_plan",
        "command": "{{orbcmd}} hook work --host {{host}}",
        "timeout": 10
      },
      {
        "matcher": ".*",
        "command": "{{orbcmd}} hook work --host {{host}} --skip-lists",
        "timeout": 10,
        "async": true
      }
    ],
    "PostToolUseFailure": [
      {
        "hosts": [
          "claude"
        ],
        "matcher": ".*",
        "command": "{{orbcmd}} hook work --host {{host}} --skip-lists",
        "timeout": 10,
        "async": true
      }
    ],
    "PreToolUse": [
      {
        "hosts": [
          "claude"
        ],
        "matcher": "AskUserQuestion",
        "command": "{{orbcmd}} hook work --host {{host}}",
        "timeout": 10,
        "async": true
      },
      {
        "hosts": [
          "codex"
        ],
        "matcher": "request_user_input",
        "command": "{{orbcmd}} hook work --host {{host}}",
        "timeout": 10,
        "async": true
      }
    ],
    "PermissionRequest": [
      {
        "command": "{{orbcmd}} hook work --host {{host}}",
        "timeout": 10,
        "async": true
      }
    ],
    "SubagentStart": [
      {
        "command": "{{orbcmd}} hook work --host {{host}}",
        "timeout": 10,
        "async": true
      }
    ],
    "SubagentStop": [
      {
        "command": "{{orbcmd}} hook work --host {{host}}",
        "timeout": 10,
        "async": true
      }
    ],
    "Stop": [
      {
        "command": "{{orbcmd}} hook work --host {{host}}",
        "timeout": 5
      }
    ],
    "SessionEnd": [
      {
        "command": "{{orbcmd}} hook session-end --host {{host}}",
        "timeout": 3
      }
    ]
  }
}
