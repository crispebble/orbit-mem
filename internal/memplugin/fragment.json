{
  "mcpServers": {
    "orbit-mem": {
      "command": "{{mem}}",
      "args": [
        "mcp"
      ],
      "envVars": [
        "ORBIT_HOME"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "command": "{{memcmd}} hook session-start --host {{host}}",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "command": "{{memcmd}} hook prompt --host {{host}}",
        "timeout": 5
      }
    ],
    "SessionEnd": [
      {
        "command": "{{memcmd}} hook session-end --host {{host}}",
        "timeout": 3
      }
    ]
  }
}
