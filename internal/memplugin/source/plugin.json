{
  "name": "orbit-mem",
  "displayName": "orbit-mem",
  "description": "이 PC의 AI 호스트가 함께 쓰는 기억: 기억 MCP 서버, 세션 시작·요청·세션 끝 훅(기억 주입·활동 기록·세션 끝 회고), 기억·감사 목록 스킬",
  "author": "onidot",
  "repository": "https://github.com/onidot-labs/orbit-mem",
  "skills": ["memory", "proposals"],
  "mcpServers": {
    "orbit-mem": {
      "command": "orbit-mem",
      "args": ["mcp"],
      "envVars": ["ORBIT_HOME"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hook": "session-start",
        "matcher": "startup|resume|clear|compact|fork",
        "timeout": 10,
        "missing": "orbit-mem 실행 파일이 PATH에 없습니다. https://github.com/onidot-labs/orbit-mem 안내대로 설치한 뒤 `orbit-mem install`을 실행하세요."
      }
    ],
    "UserPromptSubmit": [
      {
        "hook": "prompt",
        "timeout": 5
      }
    ],
    "SessionEnd": [
      {
        "hook": "session-end",
        "timeout": 3
      }
    ]
  }
}
