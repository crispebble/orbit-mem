{
  "name": "orbit",
  "version": "0.3.3",
  "displayName": "Orbit",
  "description": "이 PC의 기억·회고 제안과 일하는 방법(개발 스킬·역할·스택 에이전트·git 규칙)을 함께 주는 Orbit 플러그인",
  "skills": [
    "memory",
    "proposals",
    "tdd",
    "spec-first",
    "debugging",
    "plan",
    "verify",
    "frontend",
    "plain-writing",
    "explore-domain",
    "research",
    "review",
    "delegate",
    "git-commit",
    "pull-request"
  ],
  "mcpServers": {
    "orbit": {
      "command": "{{oni}}",
      "args": [
        "mcp"
      ],
      "envVars": [
        "ORBIT_HOME"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "command": "{{onicmd}} hook session-start --host {{host}}",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "command": "{{onicmd}} hook prompt --host {{host}}",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "hosts": [
          "claude"
        ],
        "matcher": "TaskCreate|TaskUpdate|TaskGet|TaskList|TodoWrite|mcp__ccd_turn__update_plan",
        "command": "{{onicmd}} hook work --host {{host}}",
        "timeout": 10
      },
      {
        "hosts": [
          "codex"
        ],
        "matcher": "update_plan",
        "command": "{{onicmd}} hook work --host {{host}}",
        "timeout": 10
      },
      {
        "matcher": ".*",
        "command": "{{onicmd}} hook work --host {{host}} --skip-lists",
        "timeout": 10,
        "async": true
      }
    ],
    "PostToolUseFailure": [
      {
        "hosts": [
          "claude"
        ],
        "matcher": ".*",
        "command": "{{onicmd}} hook work --host {{host}} --skip-lists",
        "timeout": 10,
        "async": true
      }
    ],
    "PreToolUse": [
      {
        "hosts": [
          "claude"
        ],
        "matcher": "AskUserQuestion",
        "command": "{{onicmd}} hook work --host {{host}}",
        "timeout": 10,
        "async": true
      },
      {
        "hosts": [
          "codex"
        ],
        "matcher": "request_user_input",
        "command": "{{onicmd}} hook work --host {{host}}",
        "timeout": 10,
        "async": true
      }
    ],
    "PermissionRequest": [
      {
        "command": "{{onicmd}} hook work --host {{host}}",
        "timeout": 10,
        "async": true
      }
    ],
    "SubagentStart": [
      {
        "command": "{{onicmd}} hook work --host {{host}}",
        "timeout": 10,
        "async": true
      }
    ],
    "SubagentStop": [
      {
        "command": "{{onicmd}} hook work --host {{host}}",
        "timeout": 10,
        "async": true
      }
    ],
    "Stop": [
      {
        "command": "{{onicmd}} hook work --host {{host}}",
        "timeout": 5
      }
    ],
    "SessionEnd": [
      {
        "command": "{{onicmd}} hook session-end --host {{host}}",
        "timeout": 3
      }
    ]
  },
  "agentsCommon": "agents-common.md",
  "agents": [
