      "@onidot-labs/studio-plugin/ai": ["./node_modules/@onidot-labs/forma-ai/dist/plugin-kit.d.ts"],
      "@onidot-labs/studio-plugin/code": ["./node_modules/@onidot-labs/forma-ui/dist/code/index.d.ts"]
