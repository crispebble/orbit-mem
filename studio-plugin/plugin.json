{
  "id": "orbit",
  "name": "Orbit",
  "version": "0.1.0",
  "studioApi": "^0.1.10",
  "main": "dist/index.js",
  "styles": ["dist/index.css"],
  "description": "Orbit 기억·제안과 AI 작업 그래프·세션을 Studio에서 봅니다.",
  "apps": [
    {
      "id": "orbit",
      "title": "Orbit",
      "icon": "icon.svg",
      "tabs": true,
      "split": true,
      "views": [
        {"id": "proposals", "title": "제안"},
        {"id": "memories", "title": "기억"},
        {"id": "works", "title": "작업"},
        {"id": "sessions", "title": "세션"}
      ]
    }
  ],
  "tabTypes": [
    {"id": "proposal", "app": "orbit"},
    {"id": "memory", "app": "orbit"},
    {"id": "work", "app": "orbit"},
    {"id": "session", "app": "orbit"}
  ],
  "commands": [
    {"id": "orbit.find", "title": "기억 찾기"},
    {"id": "orbit.proposals", "title": "제안 보기"},
    {"id": "orbit.works", "title": "작업 보기"},
    {"id": "orbit.sessions", "title": "세션 보기"}
  ],
  "inbox": true,
  "connections": {
    "mcp": [
      {"id": "oni", "command": "oni", "args": ["mcp"]},
      {"id": "work", "command": "oni", "args": ["mcp", "--reader"]}
    ]
  }
}
