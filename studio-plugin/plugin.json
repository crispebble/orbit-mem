{
  "id": "orbit",
  "name": "OpenOrbit",
  "version": "0.1.0",
  "studioApi": "^0.1.20",
  "main": "dist/index.js",
  "styles": [
    "dist/index.css"
  ],
  "description": "View OpenOrbit memories, the memory graph and proposals in Orbit Studio, and put AI work on the Orbit Studio home map.",
  "apps": [
    {
      "id": "orbit",
      "title": "OpenOrbit",
      "icon": "icon.svg",
      "tabs": true,
      "split": true,
      "views": [
        {
          "id": "proposals",
          "title": "Proposals"
        },
        {
          "id": "memories",
          "title": "Memories"
        }
      ]
    }
  ],
  "tabTypes": [
    {
      "id": "proposal",
      "app": "orbit"
    },
    {
      "id": "memory",
      "app": "orbit"
    },
    {
      "id": "work",
      "app": "orbit"
    },
    {
      "id": "session",
      "app": "orbit"
    },
    {
      "id": "memory-graph",
      "app": "orbit"
    }
  ],
  "commands": [
    {
      "id": "orbit.find",
      "title": "Find memories"
    },
    {
      "id": "orbit.memory-graph",
      "title": "Show memory graph"
    },
    {
      "id": "orbit.proposals",
      "title": "Show proposals"
    }
  ],
  "inbox": true,
  "connections": {
    "mcp": [
      {
        "id": "oni",
        "command": "orb",
        "args": [
          "mcp"
        ]
      },
      {
        "id": "work",
        "command": "orb",
        "args": [
          "mcp",
          "--reader"
        ]
      }
    ]
  },
  "locales": {
    "ko": {
      "description": "OpenOrbit 기억·기억 그래프·제안을 Orbit Studio에서 보고, AI 작업을 Orbit Studio 홈 작업 지도에 올립니다.",
      "apps": {
        "orbit": {
          "views": {
            "proposals": "제안",
            "memories": "기억"
          }
        }
      },
      "commands": {
        "orbit.find": "기억 찾기",
        "orbit.memory-graph": "기억 그래프 보기",
        "orbit.proposals": "제안 보기"
      }
    }
  }
}
