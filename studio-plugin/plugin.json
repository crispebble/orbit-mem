{
  "id": "orbit",
  "name": "OpenOrbit",
  "version": "0.4.0",
  "studioApi": "^0.1.20",
  "main": "dist/index.js",
  "styles": [
    "dist/index.css"
  ],
  "description": "View OpenOrbit memories, the memory graph and proposals in Orbit Studio, put AI work on the Orbit Studio home map, and answer agents' decision cards in Needs you.",
  "apps": [
    {
      "id": "orbit",
      "title": "OpenOrbit",
      "icon": "icon.svg",
      "tabs": true,
      "split": true,
      "views": [
        {
          "id": "proposals",
          "title": "Audit"
        },
        {
          "id": "memories",
          "title": "Memories"
        },
        {
          "id": "profiles",
          "title": "Run profiles"
        }
      ]
    }
  ],
  "tabTypes": [
    {
      "id": "proposal",
      "app": "orbit"
    },
    {
      "id": "memory",
      "app": "orbit"
    },
    {
      "id": "work",
      "app": "orbit"
    },
    {
      "id": "session",
      "app": "orbit"
    },
    {
      "id": "memory-graph",
      "app": "orbit"
    },
    {
      "id": "profiles",
      "app": "orbit"
    }
  ],
  "commands": [
    {
      "id": "orbit.find",
      "title": "Find memories"
    },
    {
      "id": "orbit.memory-graph",
      "title": "Show memory graph"
    },
    {
      "id": "orbit.proposals",
      "title": "Show audit list"
    }
  ],
  "connections": {
    "mcp": [
      {
        "id": "memory",
        "command": "orbit-mem",
        "args": [
          "mcp",
          "--actor",
          "user"
        ]
      },
      {
        "id": "work",
        "command": "orb",
        "args": [
          "work",
          "mcp"
        ]
      },
      {
        "id": "mem",
        "command": "orbit-mem",
        "args": [
          "mcp",
          "--reader"
        ]
      }
    ]
  },
  "locales": {
    "ko": {
      "description": "OpenOrbit 기억·기억 그래프·제안을 Orbit Studio에서 보고, AI 작업을 홈 작업 지도에 올리며, 에이전트의 결정 카드에 확인할 일에서 답합니다.",
      "apps": {
        "orbit": {
          "views": {
            "proposals": "감사",
            "memories": "기억",
            "profiles": "실행 프로필"
          }
        }
      },
      "commands": {
        "orbit.find": "기억 찾기",
        "orbit.memory-graph": "기억 그래프 보기",
        "orbit.proposals": "감사 목록 보기"
      },
      "toolWindows": {
        "chat": "작업 대화"
      }
    }
  },
  "backend": {
    "main": "dist/backend.js"
  },
  "secrets": true,
  "toolWindows": [
    {
      "id": "chat",
      "title": "Work chat"
    }
  ]
}
